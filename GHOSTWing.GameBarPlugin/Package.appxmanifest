<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap mp uap3">

  <Identity
    Name="GHOSTWingOverlay"
    Publisher="CN=anand"
    Version="1.0.4.0" />

  <mp:PhoneIdentity PhoneProductId="a8d3b5b6-7c3e-4b72-8e79-58b688c22d7c" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>GHOSTWing GB Overlay</DisplayName>
    <PublisherDisplayName>GHOSTWing</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="GHOSTWing.GameBarPlugin.App">
      <uap:VisualElements
        DisplayName="GHOSTWing Game Bar Overlay"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Game Bar Plugin for GHOSTWing"
        BackgroundColor="#1C1C1C">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      
      <!-- GAME BAR EXTENSION -->
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="microsoft.gameBarUIExtension"
                             Id="GHOSTWingOverlayWidget"
                             DisplayName="GHOSTWing Overlay"
                             Description="GHOSTWing Overlay Widget"
                             PublicFolder="Public">
            <uap3:Properties>
              <GameBarWidget Type="Standard" AllowForegroundTransparency="true">
                <Window>
                  <Size>
                    <Height>800</Height>
                    <Width>1000</Width>
                    <MinHeight>300</MinHeight>
                    <MinWidth>400</MinWidth>
                    <MaxHeight>4320</MaxHeight>
                    <MaxWidth>7680</MaxWidth>
                  </Size>
                  <ResizeSupported>
                    <Horizontal>true</Horizontal>
                    <Vertical>true</Vertical>
                  </ResizeSupported>
                </Window>
              </GameBarWidget>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
