<Page
    x:Class="GHOSTWing.GameBarPlugin.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid x:Name="RootGrid">
        <!-- SETTINGS PANEL (Only visible/clickable when Game Bar is open) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Button x:Name="btnCenterFullscreen" Content="Center &amp; Fullscreen" Background="#20FFFFFF" Foreground="White" BorderBrush="#50FFFFFF" BorderThickness="1" Padding="10,5" Click="btnCenterFullscreen_Click" />
        </StackPanel>

        <!-- STATS OVERLAY -->
        <Border x:Name="StatsContainer" 
                IsHitTestVisible="False"
                Visibility="Collapsed" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Padding="6,4" 
                CornerRadius="6" 
                Background="#20000000" 
                BorderThickness="1" 
                BorderBrush="White">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VP: " Foreground="White" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="txtVP" Text="1.25" Foreground="Lime" FontSize="11" FontWeight="Black" Margin="0,0,10,0"/>
                
                <TextBlock Text="DL: " Foreground="White" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="txtDL" Text="5ms" Foreground="Lime" FontSize="11" FontWeight="Black"/>
            </StackPanel>
        </Border>

        <!-- CROSSHAIR OVERLAY -->
        <Canvas x:Name="CrosshairCanvas" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <!-- Dynamically populated by code-behind -->
        </Canvas>

        <!-- TOAST NOTIFICATION -->
        <Border x:Name="ToastContainer"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,200,0,0"
                Padding="15,5"
                CornerRadius="15"
                Background="#B3000000"
                BorderThickness="1"
                BorderBrush="#D32F2F">
            <TextBlock x:Name="txtToast" Text="Notification" Foreground="White" FontSize="14" FontWeight="Bold" />
        </Border>
    </Grid>
</Page>
